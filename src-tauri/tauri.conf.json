{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "screen-dimmer",
  "version": "0.1.0",
  "identifier": "com.aiintnowayy.screendimmer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Screen Dimmer",
        "url": "index.html",
        "width": 420,
        "height": 480,
        "resizable": false,
        "fullscreen": false,
        "visible": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
